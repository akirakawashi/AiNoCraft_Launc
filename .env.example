# LOLICRAFT LAUNCHER - Environment Variables


# ============================================
# API Configuration
# ============================================
# API base URL for authentication and game data
API_URL=https://api.example.com/v1
API_TIMEOUT=30


# ============================================
# URL LINKS
# ============================================
# Game files download server
URL_DOWNLOAD=https://download.example.com
# Password recovery page
URL_FORGOT_PASSWORD=https://example.com/forgot-password
# Official website
URL_SITE=https://example.com

# ============================================
# MINECRAFT START CONFIGURATION
# ============================================
# Java version (e.g., "17", "21")
JAVA_VERSION=17
# Memory allocation in MB (e.g., 4096 for 4GB)
JAVA_MEMORY=4096
# Memory for JSON processing in MB
JAVA_JSON_MEMORY=512

# ============================================
# LAUNCHER SETTINGS
# ============================================
# Display name of the launcher
LAUNCHER_NAME=LoliCraft Launcher
# Main window dimensions
LAUNCHER_WINDOW_WIDTH=1200
LAUNCHER_WINDOW_HEIGHT=700
# Background image path (relative to assets/img/)
LAUNCHER_BACKGROUND=background.png
# Icon file path (relative to assets/icon/)
LAUNCHER_ICON=icon.ico

